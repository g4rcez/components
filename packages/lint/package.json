{
    "name": "@g4rcez/lint",
    "version": "0.1.0",
    "private": true,
    "description": "Oxlint rules for Tailwind design systems.",
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "./dist/tailwind-worker.mjs"
    ],
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "pnpm run build && vitest run --config vitest.config.ts",
        "format": "oxfmt --write .",
        "lint": "oxlint ."
    },
    "dependencies": {
        "cn": "0.2.6",
        "oxc-parser": "^0.148.0"
    },
    "devDependencies": {
        "@types/node": "25.9.1",
        "oxfmt": "0.48.0",
        "oxlint": "1.63.0",
        "tailwindcss": "4.1.11",
        "tsdown": "^0.12.0",
        "typescript": "6.0.3",
        "vitest": "4.1.7"
    },
    "engines": {
        "node": ">=20.19"
    }
}
