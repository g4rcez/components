{
    "name": "@g4rcez/components",
    "version": "5.0.6",
    "private": false,
    "description": "Customizable react components.",
    "keywords": [
        "agent-skill",
        "ai-agents",
        "claude-skill",
        "components",
        "design-system",
        "react",
        "skill",
        "tailwindcss"
    ],
    "homepage": "https://github.com/g4rcez/components#readme",
    "bugs": {
        "url": "https://github.com/g4rcez/components/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Allan Garcez",
        "email": "allan.f.garcez@gmail.com",
        "url": "https://garcez.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/g4rcez/components"
    },
    "source": "./src/index.ts",
    "files": [
        "dist",
        "dist/index.css",
        "ai"
    ],
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./index.css": "./dist/index.css",
        "./dist/index.css": "./dist/index.css",
        "./themes": {
            "types": "./dist/styles/theme.d.ts",
            "import": "./dist/styles/theme.mjs",
            "default": "./dist/styles/theme.mjs"
        },
        "./styles": {
            "types": "./dist/styles/design-tokens.d.ts",
            "import": "./dist/styles/design-tokens.mjs",
            "default": "./dist/styles/design-tokens.mjs"
        },
        "./plugin.tailwind": {
            "types": "./dist/preset/plugin.tailwind.d.ts",
            "import": "./dist/preset/plugin.tailwind.js",
            "require": "./dist/preset/plugin.tailwind.js",
            "default": "./dist/preset/plugin.tailwind.js"
        },
        "./preset.tailwind": {
            "types": "./dist/preset/preset.tailwind.d.ts",
            "import": "./dist/preset/preset.tailwind.js",
            "require": "./dist/preset/preset.tailwind.js",
            "default": "./dist/preset/preset.tailwind.js"
        },
        "./components/*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.mjs",
            "default": "./dist/components/*.mjs"
        },
        "./tag": {
            "types": "./dist/components/core/tag.d.ts",
            "import": "./dist/components/core/tag.mjs",
            "default": "./dist/components/core/tag.mjs"
        },
        "./button": {
            "types": "./dist/components/core/button.d.ts",
            "import": "./dist/components/core/button.mjs",
            "default": "./dist/components/core/button.mjs"
        },
        "./form": {
            "types": "./dist/components/form/form.d.ts",
            "import": "./dist/components/form/form.mjs",
            "default": "./dist/components/form/form.mjs"
        },
        "./radiobox": {
            "types": "./dist/components/form/radiobox.d.ts",
            "import": "./dist/components/form/radiobox.mjs",
            "default": "./dist/components/form/radiobox.mjs"
        },
        "./date-picker": {
            "types": "./dist/components/form/date-picker.d.ts",
            "import": "./dist/components/form/date-picker.mjs",
            "default": "./dist/components/form/date-picker.mjs"
        },
        "./task-list": {
            "types": "./dist/components/form/task-list.d.ts",
            "import": "./dist/components/form/task-list.mjs",
            "default": "./dist/components/form/task-list.mjs"
        },
        "./checkbox": {
            "types": "./dist/components/form/checkbox.d.ts",
            "import": "./dist/components/form/checkbox.mjs",
            "default": "./dist/components/form/checkbox.mjs"
        },
        "./input": {
            "types": "./dist/components/form/input.d.ts",
            "import": "./dist/components/form/input.mjs",
            "default": "./dist/components/form/input.mjs"
        },
        "./autocomplete": {
            "types": "./dist/components/form/autocomplete.d.ts",
            "import": "./dist/components/form/autocomplete.mjs",
            "default": "./dist/components/form/autocomplete.mjs"
        },
        "./switch": {
            "types": "./dist/components/form/switch.d.ts",
            "import": "./dist/components/form/switch.mjs",
            "default": "./dist/components/form/switch.mjs"
        },
        "./file-upload": {
            "types": "./dist/components/form/file-upload.d.ts",
            "import": "./dist/components/form/file-upload.mjs",
            "default": "./dist/components/form/file-upload.mjs"
        },
        "./select": {
            "types": "./dist/components/form/select.d.ts",
            "import": "./dist/components/form/select.mjs",
            "default": "./dist/components/form/select.mjs"
        },
        "./expand": {
            "types": "./dist/components/floating/expand.d.ts",
            "import": "./dist/components/floating/expand.mjs",
            "default": "./dist/components/floating/expand.mjs"
        },
        "./dropdown": {
            "types": "./dist/components/floating/dropdown.d.ts",
            "import": "./dist/components/floating/dropdown.mjs",
            "default": "./dist/components/floating/dropdown.mjs"
        },
        "./modal": {
            "types": "./dist/components/floating/modal.d.ts",
            "import": "./dist/components/floating/modal.mjs",
            "default": "./dist/components/floating/modal.mjs"
        },
        "./tooltip": {
            "types": "./dist/components/floating/tooltip.d.ts",
            "import": "./dist/components/floating/tooltip.mjs",
            "default": "./dist/components/floating/tooltip.mjs"
        },
        "./notifications": {
            "types": "./dist/components/display/notifications.d.ts",
            "import": "./dist/components/display/notifications.mjs",
            "default": "./dist/components/display/notifications.mjs"
        },
        "./timeline": {
            "types": "./dist/components/display/timeline.d.ts",
            "import": "./dist/components/display/timeline.mjs",
            "default": "./dist/components/display/timeline.mjs"
        },
        "./list": {
            "types": "./dist/components/display/list.d.ts",
            "import": "./dist/components/display/list.mjs",
            "default": "./dist/components/display/list.mjs"
        },
        "./calendar": {
            "types": "./dist/components/display/calendar.d.ts",
            "import": "./dist/components/display/calendar.mjs",
            "default": "./dist/components/display/calendar.mjs"
        },
        "./masonry": {
            "types": "./dist/components/display/masonry.d.ts",
            "import": "./dist/components/display/masonry.mjs",
            "default": "./dist/components/display/masonry.mjs"
        },
        "./card": {
            "types": "./dist/components/display/card.d.ts",
            "import": "./dist/components/display/card.mjs",
            "default": "./dist/components/display/card.mjs"
        },
        "./table": {
            "types": "./dist/components/table/index.d.ts",
            "import": "./dist/components/table/index.mjs",
            "default": "./dist/components/table/index.mjs"
        },
        "./menu": {
            "types": "./dist/components/floating/menu.d.ts",
            "import": "./dist/components/floating/menu.mjs",
            "default": "./dist/components/floating/menu.mjs"
        },
        "./tabs": {
            "types": "./dist/components/display/tabs.d.ts",
            "import": "./dist/components/display/tabs.mjs",
            "default": "./dist/components/display/tabs.mjs"
        },
        "./stats": {
            "types": "./dist/components/display/stats.d.ts",
            "import": "./dist/components/display/stats.mjs",
            "default": "./dist/components/display/stats.mjs"
        },
        "./alert": {
            "types": "./dist/components/display/alert.d.ts",
            "import": "./dist/components/display/alert.mjs",
            "default": "./dist/components/display/alert.mjs"
        },
        "./ai/*": "./ai/*"
    },
    "scripts": {
        "watch": "vite build --watch --minify false",
        "prepublishOnly": "npm run build",
        "build": "rm -rf ./dist; vite build; npm run lib:types; npm run preset; npm run lib:css",
        "format": "oxfmt --write .",
        "lint": "oxlint .",
        "lib:css": "BUILD_LIB=true tailwind -i ./src/index.css -o ./dist/index.css --minify",
        "lib:tailwind": "tsc -p tsconfig.tailwind.json",
        "lib:types": "tsc -p tsconfig.lib.json",
        "preset": "tsc -p tsconfig.styles.json && tsc -p tsconfig.tailwind.json",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "@base-ui/react": "1.5.0",
        "@floating-ui/react": "0.27.19",
        "@phosphor-icons/react": "2.1.10",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "date-fns": "4.3.0",
        "linq-arrays": "3.2.5",
        "motion": "12.40.0",
        "pretty-bytes": "7.1.0",
        "qs": "6.15.2",
        "react-dropzone": "15.0.0",
        "react-use-measure": "2.1.7",
        "react-virtuoso": "4.18.7",
        "sidekicker": "0.1.10",
        "storage-manager-js": "4.2.6-5",
        "tailwind-merge": "3.4.0",
        "the-mask-input": "3.3.14",
        "use-sync-external-store": "1.6.0",
        "use-typed-reducer": "4.3.0",
        "zod": "3.25.67"
    },
    "devDependencies": {
        "@tailwindcss/forms": "0.5.11",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "25.9.1",
        "@types/qs": "6.15.1",
        "@types/react": "19.2.15",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "jsdom": "29.1.1",
        "postcss": "8.5.15",
        "tailwindcss": "3.4.14",
        "tslib": "2.8.1",
        "typescript": "6.0.3",
        "vite": "8.0.14",
        "vitest": "4.1.7",
        "vitest-axe": "0.1.0"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "engines": {
        "node": ">=20.14.0"
    },
    "packageManager": "pnpm@10.12.3",
    "agents": {
        "skills": [
            {
                "name": "g4rcez-components",
                "path": "./ai/SKILL.md",
                "docs": "./ai/docs/index.md",
                "version": "1"
            }
        ]
    },
    "skill": {
        "name": "g4rcez-components",
        "path": "./ai/SKILL.md",
        "docs": "./ai/docs/index.md",
        "version": "1"
    }
}
