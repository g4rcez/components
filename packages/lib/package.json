        "lint": "oxlint .",
        "lib:tailwind": "tsc -p tsconfig.tailwind.json",
        "lib:types": "tsc -p tsconfig.lib.json",
        "preset": "tsc -p tsconfig.styles.json && tsc -p tsconfig.tailwind.json",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "styles:imports": "node ./bin/csscomponents.mjs",
        "lib:css:v6": "vite build --config vite.css.config.mts && node ./scripts/write-css-sourcemaps.mjs",
        "lib:style-manifest": "node ./scripts/build-style-manifest.mjs"
