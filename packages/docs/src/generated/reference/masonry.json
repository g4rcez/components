ions."}]]]},{"k":"h","text":"MasonryItem"},{"k":"p","c":[{"t":"code","v":"MasonryItem"},{"t":"text","v":" is an optional wrapper for an item that needs an explicit width. It accepts the standard props of its polymorphic root ("},{"t":"code","v":"li"},{"t":"text","v":" by default) and:"}]},{"k":"table","columns":["Prop","Type","Default","Description"],"rows":[[[{"t":"code","v":"width"}],[{"t":"code","v":"React.CSSProperties[\"width\"]"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Requested item width. "},{"t":"code","v":"\"100%\""},{"t":"text","v":" reserves a full row."}]],[[{"t":"code","v":"children"}],[{"t":"code","v":"React.ReactNode"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Item content."}]]]},{"k":"p","c":[{"t":"code","v":"MasonryLayout"},{"t":"text","v":" has the shape "},{"t":"code","v":"{ columns, gutter, height, items }"},{"t":"text","v":". Each item has "},{"t":"code","v":"index"},{"t":"text","v":", "},{"t":"code","v":"column"},{"t":"text","v":", "},{"t":"code","v":"top"},{"t":"text","v":", "},{"t":"code","v":"left"},{"t":"text","v":", "},{"t":"code","v":"width"},{"t":"text","v":", and "},{"t":"code","v":"height"},{"t":"text","v":"."}]}],"attributes":[{"k":"ul","items":[[{"t":"code","v":"data-component=\"masonry\""},{"t":"text","v":": root layout element."}],[{"t":"code","v":"data-component=\"masonry-item\""},{"t":"text","v":": each item wrapper."}]]}],"tokens":[{"k":"p","c":[{"t":"text","v":"Masonry has no component-specific design tokens. Its generated CSS contract is "},{"t":"code","v":".__masonry"},{"t":"text","v":" and "},{"t":"code","v":".__masonry__item"},{"t":"text","v":". Add spacing, surface, and color tokens to the child content, or override these selectors in your stylesheet."}]}],"usage":{"do":[[{"t":"text","v":"Keep child keys stable, so measurements map to the correct items."}],[{"t":"text","v":"Use "},{"t":"code","v":"MasonryItem"},{"t":"text","v":" for featured or explicit-width content."}],[{"t":"text","v":"Change "},{"t":"code","v":"fres