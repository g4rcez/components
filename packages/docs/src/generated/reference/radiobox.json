,[{"t":"code","v":"Radiobox"},{"t":"text","v":" renders a native radio inside a label."}],[{"t":"text","v":"A true group needs the same nonempty "},{"t":"code","v":"name"},{"t":"text","v":" and the same form owner for every related input."}],[{"t":"text","v":"A true group also needs distinct option "},{"t":"code","v":"value"},{"t":"text","v":" values and a consumer-supplied "},{"t":"code","v":"fieldset"},{"t":"text","v":"/"},{"t":"code","v":"legend"},{"t":"text","v":"."}],[{"t":"text","v":"Visual proximity or identical labels do not create exclusivity."}],[{"t":"text","v":"Clicking or tapping a label selects its option and clears another radio in the native group. It does not toggle a selected option off."}],[{"t":"text","v":"Native Tab entry, arrow-key selection, and Space behavior stay browser-owned. With no selection, entry can differ by browser and navigation direction."}],[{"t":"text","v":"CSS supplies focus and selected-state indicators. Verify them, and verify label target size on small screens."}],[{"t":"text","v":"There is no group component, automatic group label, error renderer, or live announcement."}],[{"t":"text","v":"Consumers own "},{"t":"code","v":"required"},{"t":"text","v":", help/error text with "},{"t":"code","v":"aria-describedby"},{"t":"text","v":", and controlled state consistency."}],[{"t":"text","v":"Keep nested links and buttons outside radio labels."}],[{"t":"text","v":"Verify the group name, option name, selected state, and position information with the supported assistive technologies."}]]}]}
