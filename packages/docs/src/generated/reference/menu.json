\"menuitemradio\" | \"menuitemcheckbox\""}],[{"t":"code","v":"\"menuitem\""}],[{"t":"text","v":"ARIA role. Use "},{"t":"code","v":"menuitemradio"},{"t":"text","v":" for one choice in a group and "},{"t":"code","v":"menuitemcheckbox"},{"t":"text","v":" for an independent toggle."}]],[[{"t":"code","v":"checked"}],[{"t":"code","v":"boolean"}],[{"t":"code","v":"false"}],[{"t":"text","v":"Selection state of a radio or checkbox item. Sets "},{"t":"code","v":"aria-checked"},{"t":"text","v":" and draws a "},{"t":"code","v":"Check"},{"t":"text","v":" icon. Ignored for "},{"t":"code","v":"menuitem"},{"t":"text","v":"."}]],[[{"t":"code","v":"onClick"}],[{"t":"code","v":"function"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Click handler."}]]]}],"attributes":[{"k":"table","columns":["Attribute","Applied to","Description"],"rows":[[[{"t":"code","v":"data-open"}],[{"t":"text","v":"Menu trigger, MenuItem"}],[{"t":"text","v":"Present when the menu/item is open"}]],[[{"t":"code","v":"data-nested"}],[{"t":"text","v":"Nested menu trigger"}],[{"t":"text","v":"Present on triggers that open a submenu"}]],[[{"t":"code","v":"data-focus-inside"}],[{"t":"text","v":"Menu trigger"}],[{"t":"text","v":"Present when focus is inside an open submenu"}]],[[{"t":"code","v":"data-active"}],[{"t":"text","v":"MenuItem"}],[{"t":"text","v":"Present on the currently focused item"}]]]}],"tokens":[{"k":"p","c":[{"t":"text","v":"Geometry defaults use scoped "},{"t":"code","v":"calc"},{"t":"text","v":" fallbacks from "},{"t":"code","v":"--var-spacing-base"},{"t":"text","v":" and the independent "},{"t":"code","v":"--var-radius-base"},{"t":"text","v":". Explicit semantic overrides remain unchanged. See "},{"t":"link","href":"https://github.com/g4rcez/components/blob/main/packages/lib/ai/docs/geometry-tokens.md","c":[{"t":"text","v":"Geometry tokens"}]},{"t":"text","v":" for default lookup, radius migration, theme emission, and exceptions. Current plain-CSS geometry examples (the exported "},{"t":"code","v":"defaultGeometryTokens"},{"t":"text","v":" map contains the full set):"}]},{"k":"table","columns":["Override","Library default"],"rows":[[[{"t":"code","v":"--var-menu-surface-radius"}],[{"t":"code","v":"calc(var(--var-radius-base) * 1)"}]],[[{"t":"code","v":"--var-menu-surface-padding"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 0.375)"}]],[[{"t":"code","v":"--var-menu-surface-min-inline-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 12)"}]],[[{"t":"code","v":"--var-menu-surface-max-block-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 28)"}]],[[{"t":"code","v":"--var-menu-item-radius"}],[{"t":"code","v":"calc(var(--var-radius-base) * 0.625)"}]],[[{"t":"code","v":"--var-menu-item-min-inline-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 9)"}]],[[{"t":"code","v":"--var-menu-item-padding"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 0.375) calc(var(--var-spacing-base) * 0.625)"}]],[[{"t":"code","v":"--var-menu-item-outline-width"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 0.125)"}]],[[{"t":"code","v":"--var-menu-item-outline-offset"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 0.125)"}]]]},{"k":"table","columns":["Token","CSS Variable","Purpose"],"rows":[[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-menu-surface-background"}],[{"t":"text","v":"Menu list surface background"}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-menu-surface-border"}],[{"t":"text","v":"Menu list border (a soft hairline)"}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-menu-surface-shadow"}],[{"t":"text","v":"Menu list drop shadow, built from the theme's shadow colors"}]],[[{"t":"code","v":"z-floating"}],[{"t":"code","v":"--var-layer-floating"}],[{"t":"text","v":"Floating list z-index"}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-menu-item-active-background"}],[{"t":"text","v":"Active/focused item background, a soft wash"}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-menu-item-active-foreground"}],[{"t":"text","v":"Active/focused item text, the same as the surface text"}]]]}],"usage":{"do":[[{"t":"text","v":"Set "},{"t":"code","v":"title"},{"t":"text","v":" whenever "},{"t":"code","v":"label"},{"t":"text","v":" is a React element."}],[{"t":"text","v":"Keep meaningful visible text or an explicit "},{"t":"code","v":"aria-label"},{"t":"text","v":" on the trigger."}],[{"t":"text","v":"Use nested "},{"t":"code","v":"Menu"},{"t":"text","v":" components (not just "},{"t":"code","v":"MenuItem"},{"t":"text","v":") to group secondary actions."}],[{"t":"text","v":"Use "},{"t":"code","v":"disabled"},{"t":"text","v":" for temporarily unavailable actions, so users see the option exists."}],[{"t":"text","v":"Use design-token classes ("},{"t":"code","v":"text-danger"},{"t":"text","v":", "},{"t":"code","v":"text-foreground"},{"t":"text","v":") for item text colors."}],[{"t":"text","v":"Use short, distinct trigger and item names, and consistent typeahead titles."}],[{"t":"text","v":"Use "},{"t":"code","v":"asChild"},{"t":"text","v":" when the label is an existing "},{"t":"code","v":"Button"},{"t":"text","v":", to avoid nested buttons."}]],"dont":[[{"t":"text","v":"Don't nest menus deeper than 2–3 levels."}],[{"t":"text","v":"Don't use raw utility color classes ("},{"t":"code","v":"text-red-600"},{"t":"text","v":", "},{"t":"code","v":"hover:bg-gray-100"},{"t":"text","v":") on items. Use design-token classes."}],[{"t":"text","v":"Don't use arbitrary utility values ("},{"t":"code","v":"bg-[#abc]"},{"t":"text","v":"). Override CSS variables in your "},{"t":"code","v":"@theme"},{"t":"text","v":" block."}],[{"t":"text","v":"Don't use "},{"t":"code","v":"Menu"},{"t":"text","v":" for primary navigation that must be crawlable. Use standard "},{"t":"code","v":"<a>"},{"t":"text","v":" links."}]]},"accessibility":[{"k":"ul","items":[[{"t":"text","v":"Floating UI provides looping list navigation, nested-menu navigation, Enter/Space activation, Escape/outside-press dismissal, and title-based item typeahead."}],[{"t":"text","v":"The container uses "},{"t":"code","v":"menu"},{"t":"text","v":". Each "},{"t":"code","v":"MenuItem"},{"t":"text","v":" is a native button with "},{"t":"code","v":"menuitem"},{"t":"text","v":", "},{"t":"code","v":"menuitemradio"},{"t":"text","v":", or "},{"t":"code","v":"menuitemcheckbox"},{"t":"text","v":"."}],[{"t":"text","v":"Radio and checkbox items always set "},{"t":"code","v":"aria-checked"},{"t":"text","v":". Plain "},{"t":"code","v":"menuitem"},{"t":"text","v":" items never set it."}],[{"t":"text","v":"Every item reserves the width of the check icon, so labels stay aligned whether or not an item is checked. The icon is "},{"t":"code","v":"aria-hidden"},{"t":"text","v":"; the state comes from "},{"t":"code","v":"aria-checked"},{"t":"text","v":"."}],[{"t":"text","v":"The library draws the check only. Group semantics for radio items (one checked at a time) belong to the caller."}],[{"t":"text","v":"Nested triggers expose submenu state through the role interaction."}],[{"t":"code","v":"MenuItem.title"},{"t":"text","v":" supplies the typeahead label and the HTML "},{"t":"code","v":"title"},{"t":"text","v":" attribute. Rendered children normally supply the accessible name."}],[{"t":"text","v":"Keep "},{"t":"code","v":"MenuItem.title"},{"t":"text","v":" and children consistent, or supply a suitable inherited "},{"t":"code","v":"aria-label"},{"t":"text","v":"."}],[{"t":"code","v":"data-active"},{"t":"text","v":" marks the focused menu item. The stylesheet uses active/hover/focus foreground and background tokens."}],[{"t":"code","v":"FloatingFocusManager"},{"t":"text","v":" is nonmodal. It is not a focus trap."}],[{"t":"text","v":"Root focus return is on by default. Opt out with "},{"t":"code","v":"restoreFocus={false}"},{"t":"text","v":". List navigation handles nested focus."}]]}],"interaction":[{"k":"h","text":"Selection and current behavior"},{"k":"ul","items":[[{"t":"text","v":"covers both navigation and action choices."}],[{"t":"text","v":"This "},{"t":"code","v":"Menu"},{"t":"text","v":" is an application-action menu, not a site navigation region."}],[{"t":"text","v":"For page destinations, use a named "},{"t":"code","v":"nav"},{"t":"text","v":" and native links or "},{"t":"code","v":"Button as=\"a\""},{"t":"text","v":" with "},{"t":"code","v":"aria-current=\"page\""},{"t":"text","v":". Do not apply "},{"t":"code","v":"menu"},{"t":"text","v":" semantics to visually grouped links."}],[{"t":"text","v":"Use "},{"t":"code","v":"Menu"},{"t":"text","v":" for command lists that need arrows, typeahead, or nested submenus."}],[{"t":"text","v":"Use "},{"t":"link","href":"/docs/dropdown","c":[{"t":"text","v":"Dropdown"}]},{"t":"text","v":" for a named temporary panel whose links or controls follow ordinary Tab order. It has no menu keyboard model."}],[{"t":"text","v":"Root menus support pointer activation, optional delayed hover, keyboard activation, Escape, and outside press."}],[{"t":"text","v":"Selecting a "},{"t":"code","v":"MenuItem"},{"t":"text","v":" runs its click handler and emits a tree event that closes open menus."}],[{"t":"text","v":"Opening a sibling submenu closes the other sibling."}],[{"t":"text","v":"Hover is on by default. It MUST NOT be the only access path."}],[{"t":"text","v":"Nested triggers use different click settings from the root ("},{"t":"code","v":"toggle: false"},{"t":"text","v":", "},{"t":"code","v":"ignoreMouse: true"},{"t":"text","v":")."}],[{"t":"text","v":"When you disable hover, verify pointer and touch access for each submenu. Do not assume root click behavior."}],[{"t":"code","v":"open"},{"t":"text","v":" initializes "},{"t":"code","v":"useState"},{"t":"text","v":" and does not sync on later prop changes. There is no controlled "},{"t":"code","v":"onChange"},{"t":"text","v":" API."}],[{"t":"text","v":"Set "},{"t":"code","v":"restoreFocus={false}"},{"t":"text","v":" only when closing the root must not return focus to its trigger."}],[{"t":"text","v":"The built-in submenu hint is the English text “Next menu”. No per-instance translation option exists."}],[{"t":"text","v":"Verify focus visibility and touch targets with the selected theme, submenu reachability, and root focus return."}],[{"t":"text","v":"Names, menu roles, expanded state, and disabled buttons are source-backed. Spoken announcements and mobile reading order need application testing."}]]}]}
