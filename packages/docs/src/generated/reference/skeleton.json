{"title":"Skeleton","description":"Accessible animated loading placeholders for blocks, cells, and lists.","import":"import { Skeleton, SkeletonCell, SkeletonList } from '@g4rcez/components'","category":"display","export":"{ Skeleton, SkeletonCell, SkeletonList }","source":"https://github.com/g4rcez/components/blob/main/packages/lib/ai/docs/Skeleton.md","lead":[{"k":"p","c":[{"t":"text","v":"Skeleton components show that content is loading and keep the layout stable. They render status semantics. They pulse, unless the user prefers reduced motion. Then they stay static."}]}],"props":[{"k":"h","text":"Skeleton props"},{"k":"table","columns":["Prop","Type","Default","Description"],"rows":[[[{"t":"code","v":"as"}],[{"t":"code","v":"React.ElementType"}],[{"t":"code","v":"\"span\""}],[{"t":"text","v":"Element used for the placeholder."}]],[[{"t":"code","v":"className"}],[{"t":"code","v":"string"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Additional classes."}]],[[{"t":"code","v":"style"}],[{"t":"code","v":"React.CSSProperties"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Inline styles, such as a custom width."}]]]},{"k":"h","text":"SkeletonCell"},{"k":"p","c":[{"t":"code","v":"SkeletonCell"},{"t":"text","v":" takes no props. It renders a status placeholder sized for a table or list cell."}]},{"k":"h","text":"SkeletonList"},{"k":"table","columns":["Prop","Type","Default","Description"],"rows":[[[{"t":"code","v":"rows"}],[{"t":"code","v":"number"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Number of skeleton list rows to render."}]],[[{"t":"code","v":"className"}],[{"t":"code","v":"string"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Additional classes for the list."}]]]}],"attributes":[{"k":"ul","items":[[{"t":"text","v":"The components add no custom "},{"t":"code","v":"data-*"},{"t":"text","v":" attributes. Their stable styling contract is class-based."}]]}],"tokens":[{"k":"ul","items":[[{"t":"text","v":"Geometry defaults use scoped "},{"t":"code","v":"calc"},{"t":"text","v":" fallbacks from "},{"t":"code","v":"--var-spacing-base"},{"t":"text","v":" and the independent "},{"t":"code","v":"--var-radius-base"},{"t":"text","v":"."}],[{"t":"text","v":"Explicit semantic overrides remain unchanged."}],[{"t":"text","v":"See "},{"t":"link","href":"https://github.com/g4rcez/components/blob/main/packages/lib/ai/docs/geometry-tokens.md","c":[{"t":"text","v":"Geometry tokens"}]},{"t":"text","v":" for default lookup, radius migration, theme emission, and exceptions."}],[{"t":"text","v":"The exported "},{"t":"code","v":"defaultGeometryTokens"},{"t":"text","v":" map holds the full set. Current plain-CSS geometry examples:"}]]},{"k":"table","columns":["Override","Library default"],"rows":[[[{"t":"code","v":"--var-skeleton-radius"}],[{"t":"code","v":"calc(var(--var-radius-base) / 3)"}]],[[{"t":"code","v":"--var-skeleton-cell-block-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 1.5)"}]],[[{"t":"code","v":"--var-skeleton-block-inline-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 8)"}]],[[{"t":"code","v":"--var-skeleton-block-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 2)"}]]]},{"k":"ul","items":[[{"t":"text","v":"The stylesheet is "},{"t":"code","v":"@g4rcez/components/skeleton.css"},{"t":"text","v":"."}],[{"t":"text","v":"Stable selectors: "},{"t":"code","v":".__skeleton"},{"t":"text","v":", "},{"t":"code","v":".__skeleton__cell"},{"t":"text","v":", "},{"t":"code","v":".__skeleton__block"},{"t":"text","v":", "},{"t":"code","v":".__skeleton__list"},{"t":"text","v":"."}],[{"t":"text","v":"The stylesheet reads these semantic variables: "},{"t":"code","v":"--var-skeleton-radius"},{"t":"text","v":", "},{"t":"code","v":"--var-skeleton-pulse-duration"},{"t":"text","v":", "},{"t":"code","v":"--var-skeleton-pulse-opacity"},{"t":"text","v":", "},{"t":"code","v":"--var-skeleton-block-inline-size"},{"t":"text","v":", "},{"t":"code","v":"--var-color-muted"},{"t":"text","v":"."}]]}],"usage":{"do":[[{"t":"text","v":"Place a skeleton where the loaded content will occupy the same region."}],[{"t":"text","v":"Set "},{"t":"code","v":"rows"},{"t":"text","v":" to the approximate number of items users will see."}],[{"t":"text","v":"Use "},{"t":"code","v":"as"},{"t":"text","v":" and "},{"t":"code","v":"style"},{"t":"text","v":" when the placeholder needs the same element or dimensions as the final content."}]],"dont":[[{"t":"text","v":"Don't use a skeleton for a short operation. A spinner or no indicator is less disruptive."}],[{"t":"text","v":"Don't expose placeholder text as completed content."}],[{"t":"text","v":"Don't rely on animation alone to show loading. The pulse is omitted when reduced motion is preferred. Status semantics stay intact."}]]},"accessibility":[{"k":"ul","items":[[{"t":"code","v":"Skeleton"},{"t":"text","v":" and "},{"t":"code","v":"SkeletonList"},{"t":"text","v":" expose "},{"t":"code","v":"role=\"status\""},{"t":"text","v":", "},{"t":"code","v":"aria-busy=\"true\""},{"t":"text","v":", and a localized loading label."}],[{"t":"code","v":"SkeletonCell"},{"t":"text","v":" exposes "},{"t":"code","v":"role=\"status\""},{"t":"text","v":", "},{"t":"code","v":"aria-busy=\"true\""},{"t":"text","v":", and the label "},{"t":"code","v":"Loading content"},{"t":"text","v":"."}],[{"t":"text","v":"Replace or remove the placeholder when loading finishes. Otherwise assistive technology announces stale status."}]]}],"interaction":[]}
