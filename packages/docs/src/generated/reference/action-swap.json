{"title":"ActionSwap","description":"Pill button that cycles through related states, such as Pin and Pinned, morphing width, tone, icon and label together.","import":"import { ActionSwap } from '@g4rcez/components'","category":"core","export":"{ ActionSwap }","source":"https://github.com/g4rcez/components/blob/main/packages/lib/ai/docs/ActionSwap.md","lead":[{"k":"p","c":[{"t":"text","v":"A compact pill button that moves to the next of a few related states on every press: Pin → Pinned, Compile → Compiled, dynamic, gradual and static typing. The icon, tone, width and label change together; only the characters that differ roll in."}]}],"props":[{"k":"p","c":[{"t":"code","v":"ActionSwap"},{"t":"text","v":" renders a "},{"t":"code","v":"<button type=\"button\">"},{"t":"text","v":" and forwards the other button attributes. "},{"t":"code","v":"children"},{"t":"text","v":", "},{"t":"code","v":"value"},{"t":"text","v":", "},{"t":"code","v":"defaultValue"},{"t":"text","v":" and "},{"t":"code","v":"onClick"},{"t":"text","v":" belong to the component."}]},{"k":"table","columns":["Prop","Type","Default","Description"],"rows":[[[{"t":"code","v":"states"}],[{"t":"code","v":"ActionSwapState[]"}],[{"t":"text","v":"required"}],[{"t":"text","v":"Ordered list of at least two states. The list wraps around."}]],[[{"t":"code","v":"value"}],[{"t":"code","v":"string"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Controlled state id."}]],[[{"t":"code","v":"defaultValue"}],[{"t":"code","v":"string"}],[{"t":"text","v":"first state's "},{"t":"code","v":"id"}],[{"t":"text","v":"Initial state id when uncontrolled."}]],[[{"t":"code","v":"onValueChange"}],[{"t":"code","v":"(id, state) => void"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Called when the state changes, including "},{"t":"code","v":"holdFor"},{"t":"text","v":" advances."}]],[[{"t":"code","v":"onAction"}],[{"t":"code","v":"(current, next) => void | Promise<unknown>"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Runs on press with the state being left and the one coming next. Return a promise to show a working phase."}]],[[{"t":"code","v":"failureLabel"}],[{"t":"code","v":"string"}],[{"t":"code","v":"\"Try again\""},{"t":"text","v":" (translatable)"}],[{"t":"text","v":"Shown for 1.8 seconds after "},{"t":"code","v":"onAction"},{"t":"text","v":" rejects or throws."}]],[[{"t":"code","v":"size"}],[{"t":"code","v":"\"sm\" | \"md\" | \"lg\""}],[{"t":"code","v":"\"md\""}],[{"t":"text","v":"Pill size."}]],[[{"t":"code","v":"translations"}],[{"t":"code","v":"Partial<Translations>"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Overrides "},{"t":"code","v":"actionSwapTryAgain"},{"t":"text","v":"."}]]]},{"k":"p","c":[{"t":"code","v":"ActionSwapState"},{"t":"text","v":":"}]},{"k":"table","columns":["Field","Type","Description"],"rows":[[[{"t":"code","v":"id"}],[{"t":"code","v":"string"}],[{"t":"text","v":"Stable identifier. Used as the value."}]],[[{"t":"code","v":"label"}],[{"t":"code","v":"string"}],[{"t":"text","v":"Visible label and accessible name. Keep it short: each character is its own motion element."}]],[[{"t":"code","v":"icon"}],[{"t":"code","v":"ReactNode"}],[{"t":"text","v":"16px icon. Wrapped, so any Phosphor icon works."}]],[[{"t":"code","v":"tone"}],[{"t":"code","v":"\"neutral\" | \"primary\" | \"success\" | \"warn\" | \"danger\" | \"quiet\""}],[{"t":"text","v":"Color treatment. "},{"t":"code","v":"success"},{"t":"text","v":" draws its icon in with a left-to-right wipe. Default "},{"t":"code","v":"\"neutral\""},{"t":"text","v":"."}]],[[{"t":"code","v":"pendingLabel"}],[{"t":"code","v":"string"}],[{"t":"text","v":"Shown while "},{"t":"code","v":"onAction"},{"t":"text","v":" is pending. Without it the pill folds into a round spinner."}]],[[{"t":"code","v":"holdFor"}],[{"t":"code","v":"number"}],[{"t":"text","v":"Milliseconds before the component advances to the next state on its own. Useful for brief confirmations."}]]]}],"attributes":[],"tokens":[{"k":"p","c":[{"t":"text","v":"Geometry reuses the Button tokens for each size."}]},{"k":"table","columns":["Size","Height","Horizontal padding","Font size"],"rows":[[[{"t":"code","v":"sm"}],[{"t":"code","v":"--var-button-small-height"}],[{"t":"code","v":"--var-button-small-px"}],[{"t":"code","v":"--var-button-small-font-size"}]],[[{"t":"code","v":"md"}],[{"t":"code","v":"--var-button-height"}],[{"t":"code","v":"--var-button-px"}],[{"t":"code","v":"--var-button-font-size"}]],[[{"t":"code","v":"lg"}],[{"t":"code","v":"--var-button-big-height"}],[{"t":"code","v":"--var-button-big-px"}],[{"t":"code","v":"--var-button-big-font-size"}]]]},{"k":"table","columns":["Tone","Background","Text"],"rows":[[[{"t":"code","v":"neutral"}],[{"t":"code","v":"--var-color-background"},{"t":"text","v":" with a "},{"t":"code","v":"--var-color-border"},{"t":"text","v":" hairline"}],[{"t":"code","v":"--var-color-foreground"}]],[[{"t":"code","v":"primary"}],[{"t":"code","v":"--var-color-primary"}],[{"t":"code","v":"--var-color-primary-foreground"}]],[[{"t":"code","v":"success"}],[{"t":"code","v":"--var-color-success"}],[{"t":"code","v":"--var-color-success-foreground"}]],[[{"t":"code","v":"warn"}],[{"t":"code","v":"--var-color-warn"}],[{"t":"code","v":"--var-color-warn-foreground"}]],[[{"t":"code","v":"danger"}],[{"t":"code","v":"--var-color-danger"},{"t":"text","v":" (also used for the failure phase)"}],[{"t":"code","v":"--var-color-danger-foreground"}]],[[{"t":"code","v":"quiet"}],[{"t":"code","v":"--var-color-muted"}],[{"t":"code","v":"--var-color-muted-foreground"}]]]},{"k":"p","c":[{"t":"text","v":"It also uses "},{"t":"code","v":"--var-rounded-full"},{"t":"text","v":", "},{"t":"code","v":"--var-button-gap"},{"t":"text","v":", "},{"t":"code","v":"--var-button-icon-font-size"},{"t":"text","v":", "},{"t":"code","v":"--var-color-ring"},{"t":"text","v":" and the Spinner styles for the working indicator."}]}],"usage":{"do":[[{"t":"text","v":"Use it for one control that cycles through a short list of related states."}],[{"t":"text","v":"Return a promise from "},{"t":"code","v":"onAction"},{"t":"text","v":" when the change needs the network, so the button shows a working phase and a failure."}],[{"t":"text","v":"Keep labels short and limit the number of swaps on a screen."}],[{"t":"text","v":"Give every state an "},{"t":"code","v":"id"},{"t":"text","v":" that means something to your data."}]],"dont":[[{"t":"text","v":"Don't use it for a one-off save. Use "},{"t":"code","v":"Button"},{"t":"text","v":" with "},{"t":"code","v":"loading"},{"t":"text","v":"."}],[{"t":"text","v":"Don't use it to choose among many options. Use "},{"t":"code","v":"Select"},{"t":"text","v":", "},{"t":"code","v":"MorphSelect"},{"t":"text","v":" or "},{"t":"code","v":"Tabs"},{"t":"text","v":"."}],[{"t":"text","v":"Don't put the only copy of important information in the icon: the label carries it."}]]},"accessibility":[{"k":"ul","items":[[{"t":"text","v":"It is a native button. Its accessible name is the visible label; while working it is "},{"t":"code","v":"pendingLabel"},{"t":"text","v":", or the current state's label when the pill is a round spinner; after a failure it is the failure label."}],[{"t":"code","v":"aria-busy"},{"t":"text","v":" and "},{"t":"code","v":"aria-disabled"},{"t":"text","v":" are set while working."}],[{"t":"text","v":"A sibling polite "},{"t":"code","v":"role=\"status\""},{"t":"text","v":" announces each new label and any failure. It stays empty on mount."}],[{"t":"text","v":"The icon and the spinner are "},{"t":"code","v":"aria-hidden"},{"t":"text","v":". The rolling characters are "},{"t":"code","v":"aria-hidden"},{"t":"text","v":"; the full label is exposed once in a visually hidden node."}],[{"t":"text","v":"Hover styles apply only to fine pointers. The focus ring uses "},{"t":"code","v":"--var-color-ring"},{"t":"text","v":"."}]]}],"interaction":[{"k":"ul","items":[[{"t":"text","v":"Enter or Space advances to the next state; a pointer press does too. At the end the list wraps to the first state."}],[{"t":"text","v":"With a sync "},{"t":"code","v":"onAction"},{"t":"text","v":" (or none) the state changes immediately. With a promise, the button enters the working phase, sets "},{"t":"code","v":"aria-busy"},{"t":"text","v":" and "},{"t":"code","v":"aria-disabled"},{"t":"text","v":", ignores further presses, and shows the working phase for at least 450ms so it never flashes. When the promise resolves the next state appears."}],[{"t":"text","v":"A rejection (or a throw) keeps the current state and shows "},{"t":"code","v":"failureLabel"},{"t":"text","v":" in the "},{"t":"code","v":"danger"},{"t":"text","v":" tone for 1.8 seconds. Pressing during that time retries. After it, the button returns to the current state."}],[{"t":"code","v":"holdFor"},{"t":"text","v":" returns or advances the state on its own, without calling "},{"t":"code","v":"onAction"},{"t":"text","v":"."}],[{"t":"text","v":"Controlled: with "},{"t":"code","v":"value"},{"t":"text","v":", a press calls "},{"t":"code","v":"onValueChange"},{"t":"text","v":" and the parent decides."}],[{"t":"text","v":"A disabled button never acts. Unmounting while working cancels the timers and does not update state."}]]}]}
