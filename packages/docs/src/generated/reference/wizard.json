{"title":"Wizard","description":"Guided tour overlay that highlights page elements step-by-step with animated SVG masking and floating tooltips.","import":"import { Wizard } from '@g4rcez/components'","category":"floating","export":"{ Wizard }","source":"https://github.com/g4rcez/components/blob/main/packages/lib/ai/docs/Wizard.md","lead":[{"k":"p","c":[{"t":"text","v":"Guided tour overlay. It highlights page elements step by step with animated SVG masking and floating tooltips."}]}],"props":[{"k":"h","text":"Wizard props"},{"k":"table","columns":["Prop","Type","Default","Description"],"rows":[[[{"t":"code","v":"active"}],[{"t":"code","v":"boolean"}],[{"t":"code","v":"false"}],[{"t":"text","v":"Shows the wizard."}]],[[{"t":"code","v":"steps"}],[{"t":"code","v":"WizardStep[]"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Ordered step configurations."}]],[[{"t":"code","v":"onClose"}],[{"t":"code","v":"() => void"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Called on skip or dismiss."}]],[[{"t":"code","v":"onFinish"}],[{"t":"code","v":"() => void"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Called when the last step completes."}]],[[{"t":"code","v":"onChange"}],[{"t":"code","v":"(index: number) => void"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Called when the step index changes."}]],[[{"t":"code","v":"labels"}],[{"t":"code","v":"{ next?: string; skip?: string; finish?: string; previous?: string }"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Button labels. Missing values use "},{"t":"code","v":"useTranslations"},{"t":"text","v":"."}]]]},{"k":"h","text":"WizardStep"},{"k":"table","columns":["Prop","Type","Default","Description"],"rows":[[[{"t":"code","v":"element"}],[{"t":"code","v":"string | Element | React.RefObject<Element | null>"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Target: CSS selector, DOM element, or React ref."}]],[[{"t":"code","v":"title"}],[{"t":"code","v":"React.ReactNode"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Step title in the tooltip."}]],[[{"t":"code","v":"description"}],[{"t":"code","v":"React.ReactNode"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Step body content."}]],[[{"t":"code","v":"side"}],[{"t":"code","v":"Placement"}],[{"t":"code","v":"\"bottom\""}],[{"t":"text","v":"Tooltip placement."}]],[[{"t":"code","v":"onEnter"}],[{"t":"code","v":"() => void"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Called when this step becomes active."}]],[[{"t":"code","v":"onNext"}],[{"t":"code","v":"() => void"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Called before advancing to the next step."}]],[[{"t":"code","v":"onPrevious"}],[{"t":"code","v":"() => void"}],[{"t":"text","v":"—"}],[{"t":"text","v":"Called before going back one step."}]]]}],"attributes":[{"k":"table","columns":["Attribute","Applied to","Description"],"rows":[[[{"t":"code","v":"data-component=\"wizard\""}],[{"t":"text","v":"Main wizard container"}],[{"t":"text","v":"Wizard overlay root"}]]]}],"tokens":[{"k":"p","c":[{"t":"text","v":"Geometry defaults are scoped "},{"t":"code","v":"calc"},{"t":"text","v":" fallbacks from "},{"t":"code","v":"--var-spacing-base"},{"t":"text","v":" and the independent "},{"t":"code","v":"--var-radius-base"},{"t":"text","v":". Explicit semantic overrides win. See "},{"t":"link","href":"https://github.com/g4rcez/components/blob/main/packages/lib/ai/docs/geometry-tokens.md","c":[{"t":"text","v":"Geometry tokens"}]},{"t":"text","v":" for default lookup, radius migration, theme emission, and exceptions. The first table lists examples. "},{"t":"code","v":"defaultGeometryTokens"},{"t":"text","v":" holds the full set."}]},{"k":"table","columns":["Override","Library default"],"rows":[[[{"t":"code","v":"--var-wizard-focus-outline-width"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 0.125)"}]],[[{"t":"code","v":"--var-wizard-focus-outline-offset"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 0.125)"}]],[[{"t":"code","v":"--var-wizard-surface-inline-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 20)"}]],[[{"t":"code","v":"--var-wizard-surface-max-inline-size"}],[{"t":"code","v":"calc(var(--var-spacing-base) * 24)"}]]]},{"k":"table","columns":["Token","CSS Variable","Purpose"],"rows":[[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-wizard-overlay-background"}],[{"t":"text","v":"SVG mask fill, including opacity"}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-wizard-surface-background"}],[{"t":"text","v":"Step tooltip surface"}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-wizard-surface-border"}],[{"t":"text","v":"Tooltip border, arrow stroke, footer divider"}]],[[{"t":"code","v":"z-wizard"}],[{"t":"code","v":"--var-layer-wizard"}],[{"t":"text","v":"Layer base. Root uses "},{"t":"code","v":"calc(var(--var-layer-wizard) + 1)"},{"t":"text","v":"."}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-wizard-label-foreground"}],[{"t":"text","v":"Step counter and skip button text"}]],[[{"t":"text","v":"CSS override"}],[{"t":"code","v":"--var-wizard-label-foreground-hover"}],[{"t":"text","v":"Skip button hover text"}]]]}],"usage":{"do":[[{"t":"text","v":"Keep tours to 3–7 steps. Fewer steps complete more often."}],[{"t":"text","v":"Make each target reachable. When a step activates and its target is not inside the viewport (with 8px of room), the wizard scrolls it to the center with "},{"t":"code","v":"scrollIntoView"},{"t":"text","v":", smoothly unless the person prefers reduced motion. Nested scrollers scroll too. A visible target is left where it is. Keyboard focus stays on the Next button so the tour keeps working from the keyboard."}],[{"t":"text","v":"Always provide "},{"t":"code","v":"onClose"},{"t":"text","v":", so users can exit at any time."}],[{"t":"text","v":"Use "},{"t":"code","v":"onEnter"},{"t":"text","v":" to make the target visible (for example, open a panel or a modal) before the step highlights it. It runs once when the step starts, before the target is looked up, even when the target does not exist yet. A step with "},{"t":"code","v":"onEnter"},{"t":"text","v":" keeps looking for its target for up to 1.5 seconds and follows it while it animates in; a step without "},{"t":"code","v":"onEnter"},{"t":"text","v":" whose target is missing centers the card at once."}]],"dont":[[{"t":"text","v":"Don't put critical information only in the wizard. Users skip it."}],[{"t":"text","v":"Don't pass more than ~10 steps. Users abandon long tours."}],[{"t":"text","v":"Don't block navigation when the user skips the wizard."}],[{"t":"text","v":"Don't pass raw utility color classes in "},{"t":"code","v":"title"},{"t":"text","v":" or "},{"t":"code","v":"description"},{"t":"text","v":". Use design-token classes."}],[{"t":"text","v":"Don't use arbitrary utility values ("},{"t":"code","v":"z-[9999]"},{"t":"text","v":"). The wizard uses "},{"t":"code","v":"z-wizard"},{"t":"text","v":". Override the CSS variable."}]]},"accessibility":[{"k":"ul","items":[[{"t":"text","v":"The wizard renders in a "},{"t":"code","v":"FloatingPortal"},{"t":"text","v":" above other content."}],[{"t":"text","v":"The overlay is "},{"t":"code","v":"pointer-events-none"},{"t":"text","v":". Only the SVG mask rect is "},{"t":"code","v":"pointer-events-auto"},{"t":"text","v":", so users can click the highlighted element during the tour."}],[{"t":"text","v":"Navigation buttons use "},{"t":"code","v":"Button"},{"t":"text","v":" and support the keyboard."}],[{"t":"text","v":"Step progress shows as "},{"t":"code","v":"{current} / {total}"},{"t":"text","v":" in the tooltip corner."}],[{"t":"text","v":"The "},{"t":"code","v":"FloatingArrow"},{"t":"text","v":" points from the tooltip to the target."}]]}],"interaction":[]}
