{"title":"formReset","description":"Utility function that resets all inputs and selects in a form to their default values and clears their initialization state.","import":"import { formReset } from '@g4rcez/components'","category":"form","export":"{ formReset }","source":"https://github.com/g4rcez/components/blob/main/packages/lib/ai/docs/FormReset.md","lead":[{"k":"p","c":[{"t":"text","v":"Resets all inputs and selects in a form to their default values and clears their initialization state."}]}],"props":[{"k":"h","text":"Signature"},{"k":"code","lang":"ts","v":"function formReset(form?: HTMLFormElement | null): void;"},{"k":"h","text":"Parameters"},{"k":"table","columns":["Parameter","Type","Description"],"rows":[[[{"t":"code","v":"form"}],[{"t":"code","v":"HTMLFormElement | null | undefined"}],[{"t":"text","v":"Form to reset. No-op if "},{"t":"code","v":"null"},{"t":"text","v":" or "},{"t":"code","v":"undefined"},{"t":"text","v":"."}]]]}],"attributes":[{"k":"ul","items":[[{"t":"code","v":"data-initialized=\"false\""},{"t":"text","v":" is set on every "},{"t":"code","v":"INPUT"},{"t":"text","v":" and "},{"t":"code","v":"SELECT"},{"t":"text","v":" element in the form. "},{"t":"code","v":"InputField"},{"t":"text","v":" reads it to decide whether to show validation feedback."}]]}],"tokens":[],"usage":{"do":[[{"t":"text","v":"Use "},{"t":"code","v":"formReset"},{"t":"text","v":", not "},{"t":"code","v":"form.reset"},{"t":"text","v":", when the form contains library components. It also resets the "},{"t":"code","v":"data-initialized"},{"t":"text","v":" flag that controls validation UI."}],[{"t":"text","v":"Pass a valid "},{"t":"code","v":"HTMLFormElement"},{"t":"text","v":" ref."}]],"dont":[[{"t":"text","v":"Don't expect "},{"t":"code","v":"formReset"},{"t":"text","v":" to fire "},{"t":"code","v":"onChange"},{"t":"text","v":" events. It sets "},{"t":"code","v":"value"},{"t":"text","v":" directly in the DOM and dispatches no React synthetic events."}],[{"t":"text","v":"D