{
    "name": "docs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "NODE_OPTIONS=--conditions=source next dev --port 10000",
        "build": "pnpm --filter @g4rcez/components build && NODE_OPTIONS=--conditions=source next build",
        "start": "next start --turbo",
        "components:styles": "node ../lib/bin/g4rcez-components.mjs styles --root . --content src --css src/app/index.css --library-root ../lib",
        "lint": "oxlint .",
        "test:e2e": "pnpm --filter @g4rcez/components build && playwright test",
        "format": "oxfmt --write ."
    },
    "dependencies": {
        "@g4rcez/components": "workspace:*",
        "@phosphor-icons/react": "2.1.10",
        "date-fns": "4.1.0",
        "motion": "12.23.26",
        "next": "16.1.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "shiki": "4.0.2",
        "simple-icons": "14.11.1",
        "use-typed-reducer": "4.2.5",
        "zod": "3.24.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tailwindcss/typography": "0.5.19",
        "@types/node": "22",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "postcss": "8",
        "tailwindcss": "3.4.14",
        "typescript": "5"
    }
}
